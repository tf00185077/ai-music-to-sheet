{
  "$id": "https://ai-music-to-sheet.invalid/contracts/1.0.0/common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "artifact_type": {
      "enum": [
        "SourceMedia",
        "CanonicalAudio",
        "SongAnalysis",
        "StemSet",
        "TrackIR",
        "NotationIR",
        "EvaluationReport",
        "ProcessTestReport"
      ]
    },
    "confidence": {
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "null"
              },
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "known",
                  "low_confidence"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "confidence": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "state": {
          "enum": [
            "known",
            "unknown",
            "low_confidence"
          ]
        },
        "value": {}
      },
      "required": [
        "state",
        "value",
        "confidence"
      ],
      "type": "object"
    },
    "content_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "failure": {
      "type": [
        "object",
        "null"
      ]
    },
    "generator": {
      "type": "object"
    },
    "human_correction": {
      "type": "boolean"
    },
    "migration": {
      "type": [
        "object",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "schema_version": {
      "pattern": "^1\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    },
    "source_artifact_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "source_artifacts": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "success",
        "low_confidence",
        "failed",
        "needs_human_confirmation"
      ]
    }
  },
  "required": [
    "artifact_type",
    "artifact_id",
    "content_hash",
    "schema_version",
    "source_artifact_ids",
    "source_artifacts",
    "generator",
    "created_at",
    "environment",
    "status",
    "confidence",
    "failure",
    "human_correction",
    "migration",
    "payload"
  ],
  "title": "P0 artifact envelope",
  "type": "object"
}
